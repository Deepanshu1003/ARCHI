# Backend — every value is optional. Without GEMINI_API_KEY the deterministic
# offline provider answers and its output is flagged as degraded.
GEMINI_API_KEY=
# Models are tried in order, best free-tier model first; the first that answers
# wins. Leave unset for the built-in default:
# gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
ARCHI_GEMINI_MODELS=
# Gemini 3 reasons before answering, so keep this generous.
ARCHI_GEMINI_TIMEOUT=60
# minimal | low | medium | high — how long Gemini 3 models think. Lower is faster.
ARCHI_GEMINI_THINKING_LEVEL=low
# Ask the API which models the key can actually call, and skip the rest. Set to
# 0 to try every configured model regardless.
ARCHI_GEMINI_DISCOVER_MODELS=1
ARCHI_LLM_PROVIDERS=gemini,offline
ARCHI_DATA_DIR=
ARCHI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARCHI_MAX_UPLOAD_BYTES=524288

# Frontend — where the UI looks for the API.
VITE_ARCHI_API_URL=http://localhost:8000
